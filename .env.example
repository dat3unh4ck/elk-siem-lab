# Plantilla de configuracion. Copiar a .env y completar los valores.
#   cp .env.example .env
# .env esta en .gitignore y NO debe subirse nunca al repositorio.

# --- Elasticsearch / Kibana -------------------------------------------------
# Contrasena del superusuario `elastic`.
ELASTIC_PASSWORD=

# Contrasena del usuario de servicio `kibana_system`.
# Se fija contra Elasticsearch en scripts/setup.sh.
KIBANA_SYSTEM_PASSWORD=

# Encryption keys de Kibana. Minimo 32 caracteres cada una y distintas entre si.
# Generar con:  openssl rand -hex 24
ENCRYPTION_KEY_SAVED_OBJECTS=
ENCRYPTION_KEY_SECURITY=
ENCRYPTION_KEY_REPORTING=

# Memoria de la JVM de Elasticsearch. Ajustar segun la RAM disponible.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Directorio de logs del host que Filebeat monta en /var/log/host (solo lectura).
HOST_LOG_DIR=/var/log

# --- Threat Intelligence (scripts/enrich_ips.py) ----------------------------
# Claves de API gratuitas. El script funciona con una sola de las dos.
ABUSEIPDB_API_KEY=
VT_API_KEY=
